# Supabase: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Saves AI results and stores images. Never expose this to the browser.
SUPABASE_SECRET_KEY=

# OpenAI writes the descriptions and creates the images
OPENAI_API_KEY=
# Optional. These are the defaults.
OPENAI_TEXT_MODEL=gpt-6-luna
OPENAI_IMAGE_MODEL=gpt-image-2
# AI generations each person can start per hour
AI_HOURLY_LIMIT_PER_USER=30

# Public address of the app, used in sign-up confirmation emails
NEXT_PUBLIC_SITE_URL=http://localhost:3000
