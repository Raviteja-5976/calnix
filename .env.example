# Supabase: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Saves AI results and stores images. Never expose this to the browser.
SUPABASE_SECRET_KEY=

# Cloudflare R2 stores images (item covers and images in docs) and chat files. Server only.
# Create a private bucket, then an R2 API token with "Object Read & Write" on it.
# Chat uploads go straight from the browser to R2: add the CORS rule from the README.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=dta-cal-files

# Runware powers every AI feature. AI only runs when someone clicks an AI button.
# Get a key at https://runware.ai
RUNWARE_API_KEY=
# Optional. These are the defaults: a cheap fast text model and a cheap image model.
RUNWARE_TEXT_MODEL=deepseek:v4@flash
RUNWARE_IMAGE_MODEL=runware:100@1
# AI requests each person can make per hour, across all AI features
AI_HOURLY_LIMIT_PER_USER=30

# Public address of the app, used in sign-up confirmation emails
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Email (confirmation links for extra emails, and the daily summary). Server only.
# Any SMTP server works: your own mail server or a sending service.
# Port 587 uses STARTTLS, 465 uses TLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="DTA-Cal <noreply@your-domain.com>"

# Protects /api/cron/daily-digest. Any long random string; the scheduler sends
# it as "Authorization: Bearer <CRON_SECRET>". Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=
